# Plantatio environment configuration.
# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# ── Application database (Postgres in production, SQLite locally) ─────────────
# Example: postgresql+psycopg2://user:password@host:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./plantatio.db

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Neo4j knowledge graph ────────────────────────────────────────────────────
# Leave blank to run without the graph: GraphRAG retrieval degrades to an empty
# context and the chat endpoint says so rather than failing.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── Agent LLM (HuggingFace transformers) ─────────────────────────────────────
# The default is an NVFP4-quantised checkpoint. NVFP4 is a 4-bit format with
# native kernels only on NVIDIA Blackwell tensor cores (RTX 50-series, B200).
# On older GPUs or CPU it will not load — point this at a model your hardware
# can run, e.g. meta-llama/Llama-3.1-8B-Instruct or Qwen/Qwen2.5-7B-Instruct.
PLANTATIO_LLM_MODEL_ID=nvidia/Llama-3.1-8B-Instruct-NVFP4
PLANTATIO_LLM_DEVICE=auto
PLANTATIO_LLM_DTYPE=auto
PLANTATIO_LLM_MAX_NEW_TOKENS=512
PLANTATIO_LLM_TRUST_REMOTE_CODE=false

# ── Vision models ────────────────────────────────────────────────────────────
# Tomato leaf-disease CNN. Produced by `python -m training.scripts.train_cnn`.
# While this file is absent, POST /api/plants/{id}/diagnose returns 503 rather
# than guessing a diagnosis.
PLANTATIO_CNN_CHECKPOINT=./models/plant_CNN_classifier_model.pth

# Satellite land-cover VLM, called through the HuggingFace Inference API.
PLANTATIO_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
PLANTATIO_VLM_PROVIDER=auto
HF_TOKEN=

# ── CNN training only (not read by the API) ──────────────────────────────────
# DATA_FILEPATH points at an ImageFolder tree: one directory per class.
DATA_FILEPATH=./training/datasets/raw/PlantVillage_Tomato
CNN_DIR_FILEPATH=./training/datasets/formatted
CLASS_WEIGHT_SAVE=./training/datasets/formatted/class_weights.pt
