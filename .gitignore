# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
api/venv/
venv/
.venv/

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
.vite/
.tanstack/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.local

# ── Model weights and checkpoints ─────────────────────────────────────────────
# Anchored to the repo root on purpose. An unanchored `models/` also matches
# source packages such as RAG/GRAPHRAG/src/models/ and training/configs/models/,
# which is how LLMManager and CNN_model were silently dropped from this repo.
/models/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.gguf

# ── Datasets and generated output ─────────────────────────────────────────────
/training/datasets/
/training/sft/data/
/RAG/GRAPHRAG/data/
/outputs/
/logs/
*.db
*.sqlite3
